{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-db-delete.mjs\"",
            "statusMessage": "Comprobando protección de la BBDD..."
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-constants-read.mjs\"",
            "statusMessage": "Comprobando acceso a CONSTANTS.js..."
          }
        ]
      }
    ]
  }
}
